generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  EUR
  USD
}

enum Period {
  MONTHLY
  YEARLY
}

model Project {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  createdAt  DateTime    @default(now())
  costEvents CostEvent[]
  fixedCosts FixedCost[]
}

// Un appel API facture (ou estime) emis par un SaaS.
// amountEur est fige a l'ingestion pour garder un historique stable.
model CostEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider   String
  endpoint   String?
  units      Float?
  unitLabel  String?
  amount     Decimal  @db.Decimal(14, 6)
  currency   Currency @default(EUR)
  amountEur  Decimal  @db.Decimal(14, 6)
  occurredAt DateTime @default(now())
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([projectId, occurredAt])
  @@index([provider, occurredAt])
  @@index([occurredAt])
}

// Cout recurrent saisi a la main (VPS, domaine, abonnement...).
// projectId vide = cout partage / infrastructure.
model FixedCost {
  id        String    @id @default(cuid())
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider  String
  label     String
  amount    Decimal   @db.Decimal(12, 2)
  currency  Currency  @default(EUR)
  amountEur Decimal   @db.Decimal(12, 2)
  period    Period    @default(MONTHLY)
  startsOn  DateTime
  endsOn    DateTime?
  createdAt DateTime  @default(now())

  @@index([startsOn, endsOn])
}
