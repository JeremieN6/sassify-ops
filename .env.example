# Base Neon (pooler) - utilisee par Prisma
# connect_timeout=15 : Neon se met en veille (plan gratuit) et son reveil peut depasser les 5 s que Prisma tolere
# par defaut, ce qui donne "Can't reach database server" sur la premiere requete apres une periode d'inactivite.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15"

# Mot de passe unique du dashboard (long, aleatoire)
NUXT_ADMIN_PASSWORD=""

# Cle de signature du cookie de session : openssl rand -base64 32
NUXT_SESSION_SECRET=""

# --- Surveillance (optionnel) ---
# Sondes de disponibilite : vide = actives en production seulement ("true"/"false" pour forcer).
# NUXT_PROBES_ENABLED=""
# NUXT_PROBE_INTERVAL_SEC="120"
# Notifications Telegram des alertes (token du bot + identifiant du chat). Sans ces deux valeurs : aucune notification.
# Noms acceptes (dans .env OU .env.local) : TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID (comme les autres apps) ou NUXT_TELEGRAM_*.
# Les messages portent l'en-tete "SASSIFY OPS" et le mot-cle #sassify_ops (le chat recoit aussi d'autres notifications).
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# NUXT_TELEGRAM_DISABLED="true"   # coupe tout envoi (postes de test qui partagent un .env.local reel)
# NUXT_SITE_URL="https://pilotage.sassify.fr"

# Cle partagee que les SaaS envoient dans l'en-tete x-ops-key : openssl rand -base64 32
NUXT_INGEST_KEY=""

# Taux de conversion applique a l'ingestion pour les couts en USD
NUXT_USD_TO_EUR="0.92"
