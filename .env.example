# Base Neon (pooler) - utilisee par Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Mot de passe unique du dashboard (long, aleatoire)
NUXT_ADMIN_PASSWORD=""

# Cle de signature du cookie de session : openssl rand -base64 32
NUXT_SESSION_SECRET=""

# Cle partagee que les SaaS envoient dans l'en-tete x-ops-key : openssl rand -base64 32
NUXT_INGEST_KEY=""

# Taux de conversion applique a l'ingestion pour les couts en USD
NUXT_USD_TO_EUR="0.92"
