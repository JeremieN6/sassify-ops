{
  "name": "ops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3020",
    "build": "nuxt build",
    "start": "node --env-file=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare && prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "demo": "node --env-file=.env --import tsx scripts/demo-data.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "nuxt": "3.21.8",
    "vue": "3.5.39",
    "vue-router": "4.6.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "prisma": "6.19.3",
    "tsx": "4.23.0"
  }
}
